# Research Analyst — Android Keystore Configuration
# Module: keystore.properties.template | Version: 0.1.0 | Updated: 2026-05-15
#
# Copy this file to keystore.properties and fill in your values.
# NEVER commit keystore.properties to git (it's in .gitignore).
#
# Generate a keystore:
#   keytool -genkey -v -keystore research-analyst.keystore \
#     -alias research-analyst -keyalg RSA -keysize 2048 -validity 10000

storeFile=research-analyst.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=research-analyst
keyPassword=YOUR_KEY_PASSWORD
