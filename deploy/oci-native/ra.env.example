# Target on box: /etc/research-analyst/ra.env   (owner root:ra, chmod 640)
#
# This is a REDACTED TEMPLATE. Never commit the real FRED key.
# On the box: copy to /etc/research-analyst/ra.env, set RA_MARKET_FRED_API_KEY
# to the real 32-char key, then: sudo systemctl restart ra
#
# Vars verified against research_analyst/config.py (env_prefix RA_ / RA_MARKET_ / RA_SERVER_ / RA_SEC_).

RA_SERVER_HOST=127.0.0.1
RA_SERVER_PORT=8700
RA_DEBUG=false
RA_MARKET_CACHE_DIR=/var/lib/research-analyst/cache
RA_SEC_USER_AGENT=Research Analyst / nrupalakolkar@gmail.com
RA_MARKET_FRED_API_KEY=__SET_ON_BOX__
